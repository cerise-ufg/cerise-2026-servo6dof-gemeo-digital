# ROS 2 Humble + Ignition Fortress (arm64) para gerar o dataset do servo6dof
# com rendering por GPU NVIDIA (EGL headless) no DGX Spark.
FROM ros:humble-ros-base
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl gnupg lsb-release ca-certificates \
    && curl -sSL https://packages.osrfoundation.org/gazebo.gpg \
        -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
    && echo "deb [arch=arm64 signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable jammy main" \
        > /etc/apt/sources.list.d/gazebo-stable.list \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
        ignition-fortress \
        ros-humble-ros-gz \
        ros-humble-ros2-control \
        ros-humble-ros2-controllers \
        ros-humble-ign-ros2-control \
        ros-humble-robot-state-publisher \
        ros-humble-xacro \
        ros-humble-cv-bridge \
        python3-opencv python3-numpy python3-yaml \
        python3-colcon-common-extensions \
        libglvnd0 libgl1 libglx0 libegl1 libgles2 \
        mesa-utils \
    && rm -rf /var/lib/apt/lists/*

ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=graphics,compute,utility,display
# Forca o glvnd a usar SO o vendor EGL da NVIDIA (sem cair no Mesa/software)
ENV __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json
ENV RENDER_DRIVER_OVERRIDE=""
WORKDIR /ws
CMD ["bash"]
