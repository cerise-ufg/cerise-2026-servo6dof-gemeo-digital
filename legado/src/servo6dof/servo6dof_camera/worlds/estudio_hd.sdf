<?xml version="1.0" ?>
<!--
  Estudio multi-modal para a geracao do dataset grande.

  Diferencas para o estudio.sdf:
    - 640x480 (resolucao escolhida por dar ~4x mais taxa de captura que HD;
      para detectar pose do braco, variedade de poses vale mais que pixels)
    - cada posicao de camera tem TRES sensores: RGB, profundidade e
      segmentacao semantica
    - <render_engine>ogre2</render_engine>

  RENDERIZACAO POR GPU (obrigatoria aqui):
    O ogre2 exige GPU. No WSL, mesmo com a GPU liberada, o driver D3D12/EGL
    cai para software e o ogre2 aborta em GL3PlusTextureGpu::copyTo. A saida
    e' o zink (OpenGL sobre Vulkan), ativado pelo launch via
    MESA_LOADER_DRIVER_OVERRIDE=zink. Pre-requisito: usuario no grupo render
    (sudo usermod -aG render $USER, depois 'wsl --shutdown' no Windows).
    Sem GPU, use o estudio.sdf padrao (ogre1, 1280x720, so RGB).

  Taxas medidas nesta maquina (Iris Xe, zink):
    modalidade mais lenta ~1 Hz (a 1920x1080 era 0,25 Hz).
  Peso por pose (2 cameras, PNG sem perda):
    RGB 2x~90 KB + depth 2x~90 KB + segm 2x~10 KB  ~=  0,2 MB.
  A escala vem do numero de poses e do paralelismo (ver gerar_dataset_paralelo.sh),
  nao da resolucao.
-->
<sdf version="1.8">
  <world name="estudio_hd">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>

    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
      <background_color>0.30 0.33 0.38</background_color>
    </plugin>

    <scene>
      <ambient>0.30 0.30 0.32 1</ambient>
      <background>0.30 0.33 0.38 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="chave">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.55 0.55 0.55 1</diffuse>
      <specular>0.08 0.08 0.08 1</specular>
      <direction>-0.5 0.35 -0.8</direction>
    </light>

    <light type="directional" name="preenchimento">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.18 0.18 0.20 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.6 -0.4 -0.5</direction>
    </light>

    <model name="chao">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.18 0.19 0.21 1</ambient>
            <diffuse>0.26 0.27 0.30 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
          <!-- rotulo 1 = chao, para a segmentacao separar do fundo -->
          <plugin filename="ignition-gazebo-label-system"
                  name="ignition::gazebo::systems::Label">
            <label>1</label>
          </plugin>
        </visual>
      </link>
    </model>

    <model name="fundo">
      <static>true</static>
      <pose>-3.5 0 3 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.2 16 6</size></box></geometry>
          <material>
            <ambient>0.30 0.32 0.36 1</ambient>
            <diffuse>0.40 0.42 0.47 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
          <plugin filename="ignition-gazebo-label-system"
                  name="ignition::gazebo::systems::Label">
            <label>2</label>
          </plugin>
        </visual>
      </link>
    </model>

    <!-- ================= POSICAO 1: frontal ================= -->
    <model name="camera_frontal">
      <static>true</static>
      <pose>3.2 0.4 1.6 0 0.215 3.14159</pose>
      <link name="link">
        <visual name="corpo">
          <geometry><box><size>0.12 0.12 0.12</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>

        <sensor name="rgb" type="camera">
          <camera>
            <horizontal_fov>1.0472</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <topic>camera_frontal/image</topic>
        </sensor>

        <sensor name="profundidade" type="depth_camera">
          <camera>
            <horizontal_fov>1.0472</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R_FLOAT32</format></image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <topic>camera_frontal/depth</topic>
        </sensor>

        <sensor name="segmentacao" type="segmentation_camera">
          <camera>
            <horizontal_fov>1.0472</horizontal_fov>
            <image><width>1280</width><height>720</height></image>
            <clip><near>0.1</near><far>100</far></clip>
            <segmentation_type>semantic</segmentation_type>
          </camera>
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <topic>camera_frontal/segmentation</topic>
        </sensor>
      </link>
    </model>

    <!-- ================= POSICAO 2: diagonal alta ================= -->
    <model name="camera_diagonal">
      <static>true</static>
      <pose>2.6 2.6 2.4 0 0.414 -2.439</pose>
      <link name="link">
        <visual name="corpo">
          <geometry><box><size>0.12 0.12 0.12</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>

        <sensor name="rgb" type="camera">
          <camera>
            <horizontal_fov>1.0472</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <topic>camera_diagonal/image</topic>
        </sensor>

        <sensor name="profundidade" type="depth_camera">
          <camera>
            <horizontal_fov>1.0472</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R_FLOAT32</format></image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <topic>camera_diagonal/depth</topic>
        </sensor>

        <sensor name="segmentacao" type="segmentation_camera">
          <camera>
            <horizontal_fov>1.0472</horizontal_fov>
            <image><width>1280</width><height>720</height></image>
            <clip><near>0.1</near><far>100</far></clip>
            <segmentation_type>semantic</segmentation_type>
          </camera>
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <topic>camera_diagonal/segmentation</topic>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
